#!/bin/sh /etc/rc.common
# E5800 touchscreen UI (/root/e5ui). Switch back to stock: /root/e5ui/toggle.sh off

START=13
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /root/e5ui/run.sh
    procd_set_param nice -10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
